{
  "name": "scent-wardrobe",
  "version": "1.0.0",
  "description": "Scent Wardrobe: a personal, offline fragrance collection manager (shelves, layering, wear diary, stats)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:mac:x64": "electron-vite build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "notice": "node scripts/generate-notice.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "productName": "Scent Wardrobe",
  "author": "MedinaPiRRy",
  "license": "MIT",
  "homepage": "https://github.com/MedinaPiRRy/scent-wardrobe#readme",
  "build": {
    "appId": "com.scentwardrobe.app",
    "productName": "Scent Wardrobe",
    "copyright": "Copyright © 2026 MedinaPiRRy. MIT licence.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Scent-Wardrobe-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scent Wardrobe",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Scent-Wardrobe-Setup-${version}.${ext}"
    },
    "extraFiles": [
      "LICENSE",
      "NOTICE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png",
      "artifactName": "Scent-Wardrobe-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Scent Wardrobe ${version}",
      "artifactName": "Scent-Wardrobe-${version}-mac-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MedinaPiRRy/scent-wardrobe.git"
  },
  "bugs": {
    "url": "https://github.com/MedinaPiRRy/scent-wardrobe/issues"
  }
}
